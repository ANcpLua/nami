<Project>
  <!-- Centralize build output to artifacts/ for most projects.
       Exception: eng/ projects need local bin/obj for NuGet pack paths. -->
  <PropertyGroup Condition="!$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').StartsWith($([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'eng'))))">
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/</ArtifactsPath>
    <BaseOutputPath>$(ArtifactsPath)bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(ArtifactsPath)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.esproj'">
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UsingMSTestSdk)' == 'true'">
    <TestingExtensionsProfile>AllMicrosoft</TestingExtensionsProfile>
  </PropertyGroup>

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- CS0618: a deprecated semantic-convention constant carries [Obsolete]; using one fails the build.
         A reader that must accept an old key says so with a narrow #pragma and a reason. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1816;CA2000;CA2012;CA2016;CS0618;CS8509;CS8655;CS8846</WarningsAsErrors>
  </PropertyGroup>

  <!-- Using an [Obsolete] member without a message (CS0612) fails every build, as CS0618 does. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CS0612</WarningsAsErrors>
  </PropertyGroup>

  <!-- Release builds and every CI build fail on any warning and on NuGet audit findings (NU1901 to
       NU1904: low to critical severity). Configuration is empty here unless -c passes it, so CI=true
       also covers CI builds without -c, such as eng/build.sh building eng/build. NativeAOT publish
       hands both properties to ILC. Kept as warnings: IL2104 and IL3053, ILC's summaries of a
       package's trim and AOT warnings (today only DuckDB.NET.Data has them), and NU1900, vulnerability
       data that could not be read, which is not a finding. Local Debug builds keep warnings as
       warnings and still audit. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053;NU1900</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Compiler-discovered configs otherwise expose their parent directory as an IDE link.
       Explicit links supplied by an SDK override this default; compiler inputs stay unchanged. -->
  <ItemDefinitionGroup>
    <EditorConfigFiles>
      <Link>Build/Configuration/%(Filename)%(Extension)</Link>
    </EditorConfigFiles>
  </ItemDefinitionGroup>


  <!-- Audit direct and transitive dependencies; Directory.Packages.props owns security overrides. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>ancplua</Authors>
    <Company>nami</Company>
    <PackageProjectUrl>https://github.com/ANcpLua/nami</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ANcpLua/nami</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>opentelemetry;genai;observability;llm;ai;telemetry</PackageTags>
    <Copyright>Copyright (c) 2025-2026 ancplua</Copyright>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)eng/MSBuild/Shared.props" />

</Project>
