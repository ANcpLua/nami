<Project>
  <Target Name="GenerateVersionConstant" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PropertyGroup>
      <_NamiProductVersion>$(Version)</_NamiProductVersion>
      <_NamiProductVersion Condition="'$(_NamiProductVersion)' == ''">0.0.0</_NamiProductVersion>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildVersion.g.cs"/>
      <FileWrites Include="$(IntermediateOutputPath)BuildVersion.g.cs"/>
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)BuildVersion.g.cs"
      Lines="namespace $(RootNamespace)%3B&#10;&#10;internal static class BuildVersion&#10;{&#10;    internal const string ProductVersion = &quot;$(_NamiProductVersion)&quot;%3B&#10;}"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"/>
  </Target>

</Project>
