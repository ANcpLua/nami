<Project>
  <Import Project="Version.props" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <!-- Transitive-only pin: nothing references it directly, but it must not float. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <!-- Transitive cryptography dependencies of NuGet and MSBuild follow the selected runtime. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(DotNetRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageVersion Include="ANcpLua.Roslyn.Utilities.Sources" Version="$(ANcpLuaRoslynUtilitiesVersion)" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="$(VisualStudioThreadingAnalyzersVersion)" />
  </ItemGroup>

  <ItemGroup Label="Storage and wire">
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="$(DuckDBVersion)" />
    <PackageVersion Include="Google.Protobuf" Version="$(GoogleProtobufVersion)" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="$(GrpcAspNetCoreVersion)" />
    <PackageVersion Include="Grpc.Net.Client" Version="$(GrpcAspNetCoreVersion)" />
    <PackageVersion Include="Grpc.Tools" Version="$(GrpcToolsVersion)" />
  </ItemGroup>


  <ItemGroup Label="Build and test tooling">
    <PackageVersion Include="Fallout.Common" Version="$(FalloutVersion)" />
    <PackageVersion Include="Fallout.Components" Version="$(FalloutVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Build" Version="[$(MicrosoftBuildVersion)]" />
    <PackageVersion Include="NuGet.Frameworks" Version="$(NuGetVersion)" />
  </ItemGroup>
  <ItemGroup Label="MCP">
    <PackageVersion Include="ModelContextProtocol" Version="$(McpVersion)" />
  </ItemGroup>
  <ItemGroup Label="Verified transitive compatibility">
    <!-- Roots only: companion packages advance through their verified owning dependencies. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="$(MicrosoftBuildLocatorVersion)" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="$(MicrosoftBuildVersion)" />
    <PackageVersion Include="Microsoft.DiaSymReader" Version="$(MicrosoftDiaSymReaderVersion)" />
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="$(MicrosoftDiagnosticsClientVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="$(MicrosoftNetCorePlatformsVersion)" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="$(MicrosoftTestPlatformObjectModelVersion)" />
    <PackageVersion Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageVersion Include="System.CodeDom" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="$(DotNetRuntimeVersion)" />
    <!-- Generators run inside the compiler/IDE host. Keep Roslyn's own dependency baseline
         there instead of requiring the application's newer runtime assemblies. -->
    <PackageVersion Include="System.Reflection.Metadata" Version="$(DotNetRuntimeVersion)" Condition="'$(MSBuildProjectName)' != 'nami.collector.storage.generators'" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="System.Resources.Extensions" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="System.Security.Permissions" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="$(DotNetRuntimeVersion)" Condition="'$(MSBuildProjectName)' != 'nami.collector.storage.generators'" />
  </ItemGroup>
  <ItemGroup Label="Fallout transitive dependencies">
    <PackageVersion Include="Azure.Core" Version="$(AzureCoreVersion)" />
    <PackageVersion Include="Azure.Identity" Version="$(AzureIdentityVersion)" />
    <PackageVersion Include="Azure.Security.KeyVault.Certificates" Version="$(AzureKeyVaultCertificatesVersion)" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="$(AzureKeyVaultKeysVersion)" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="$(AzureKeyVaultSecretsVersion)" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="$(MicrosoftIdentityClientExtensionsMsalVersion)" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="$(MicrosoftIdentityClientVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="$(MicrosoftIdentityModelAbstractionsVersion)" />
    <PackageVersion Include="System.ClientModel" Version="$(SystemClientModelVersion)" />
    <PackageVersion Include="Glob" Version="$(GlobVersion)" />
    <PackageVersion Include="Serilog" Version="$(SerilogVersion)" />
    <PackageVersion Include="Serilog.Formatting.Compact.Reader" Version="$(SerilogCompactReaderVersion)" />
    <PackageVersion Include="Serilog.Sinks.File" Version="$(SerilogFileSinkVersion)" />
    <PackageVersion Include="SharpCompress" Version="$(SharpCompressVersion)" />
    <PackageVersion Include="YamlDotNet" Version="$(YamlDotNetVersion)" />
    <PackageVersion Include="System.Memory.Data" Version="$(DotNetRuntimeVersion)" />
  </ItemGroup>
</Project>
