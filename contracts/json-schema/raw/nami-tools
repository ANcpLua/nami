{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "nami-tools",
    "$defs": {
        "SourcesStatusInput": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SourcesStatusInput.json",
            "type": "object",
            "properties": {},
            "allOf": [
                {
                    "$ref": "#/$defs/ToolReadInput"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The health of telemetry sources, including silent signals.",
            "$defs": {
                "ToolReadInput": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "description": "Filter by the producer's service.name resource attribute."
                        },
                        "since": {
                            "$ref": "#/$defs/TimeSpec",
                            "description": "Inclusive window start; defaults to one hour before the snapshot's observation time."
                        },
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "maxItems": 128,
                            "description": "Requested fields. Unknown fields are refused with the allowed field names."
                        },
                        "maxBytes": {
                            "type": "integer",
                            "minimum": 1024,
                            "maximum": 262144,
                            "default": 32768,
                            "description": "Maximum UTF-8 bytes in structuredContent, from 1024 to 262144."
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId",
                            "description": "Reuse a snapshot returned by an earlier call for byte-identical reads."
                        },
                        "cursor": {
                            "$ref": "#/$defs/Cursor",
                            "description": "Opaque next_cursor from the preceding page; keep all other arguments unchanged."
                        }
                    },
                    "description": "Arguments shared by every read-only tool."
                },
                "TimeSpec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Absolute RFC 3339 instant or a negative relative duration such as -15m, -2h, -7d or -30s."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                }
            }
        },
        "SourcesStatusResult": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SourcesStatusResult.json",
            "type": "object",
            "properties": {
                "services": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ProjectedSourceStatus"
                    }
                }
            },
            "required": [
                "services"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolResult"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Recorded service and signal activity.",
            "$defs": {
                "ProjectedSourceStatus": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "string"
                        },
                        "signals": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/SignalStatus"
                            }
                        }
                    },
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "A field projection of SourceStatus; omitted members were not requested."
                },
                "ToolResult": {
                    "type": "object",
                    "properties": {
                        "freshness": {
                            "$ref": "#/$defs/Freshness"
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/Cursor"
                        }
                    },
                    "required": [
                        "freshness",
                        "snapshotId"
                    ],
                    "description": "Evidence metadata returned with every successful tool result."
                },
                "SignalStatus": {
                    "type": "object",
                    "properties": {
                        "signal": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": "traces"
                                },
                                {
                                    "type": "string",
                                    "const": "metrics"
                                },
                                {
                                    "type": "string",
                                    "const": "logs"
                                }
                            ]
                        },
                        "kind": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": "active"
                                },
                                {
                                    "type": "string",
                                    "const": "silent"
                                }
                            ]
                        },
                        "lastSeen": {
                            "$ref": "#/$defs/Timestamp"
                        },
                        "silentFor": {
                            "$ref": "#/$defs/IsoDuration"
                        }
                    },
                    "required": [
                        "signal",
                        "kind"
                    ],
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "The latest receipt time for one signal, or how long it has been silent."
                },
                "Freshness": {
                    "type": "object",
                    "properties": {
                        "watermark": {
                            "$ref": "#/$defs/Timestamp",
                            "description": "Ingest is complete through this instant for every signal read."
                        },
                        "complete": {
                            "type": "boolean",
                            "description": "True only when the requested window ends at or before the watermark."
                        },
                        "examined": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Records examined, or null when unknown."
                        },
                        "matched": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Matching records, or null when the read was cut short."
                        },
                        "returned": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Items returned, or null when unknown."
                        },
                        "truncated": {
                            "type": "boolean",
                            "description": "True when a row limit, page limit or byte budget omitted matching items."
                        }
                    },
                    "required": [
                        "watermark",
                        "complete",
                        "examined",
                        "matched",
                        "returned",
                        "truncated"
                    ],
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "Evidence completeness for the requested window. Unknown counts remain null."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                },
                "Timestamp": {
                    "type": "string",
                    "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
                    "description": "RFC 3339 timestamp preserved exactly as text, including fractional precision and offset. Leap seconds are not supported. Execution windows additionally require an instant representable by the telemetry store."
                },
                "IsoDuration": {
                    "type": "string",
                    "pattern": "^P(?!$)(([0-9]+Y)?([0-9]+M)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?|([0-9]+W)?)(?![\\s\\S])",
                    "description": "ISO 8601 duration format (e.g., PT1H30M)"
                },
                "Count": {
                    "type": "string",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Generic non-negative counter"
                }
            }
        },
        "ErrorsRecentInput": {
