                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                }
            }
        },
        "TracesGetInput": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "TracesGetInput.json",
            "type": "object",
            "properties": {
                "traceId": {
                    "$ref": "#/$defs/TraceId"
                }
            },
            "required": [
                "traceId"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolReadInput"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Read one trace, projecting only requested fields.",
            "$defs": {
                "TraceId": {
                    "type": "string",
                    "examples": [
                        "0af7651916cd43dd8448eb211c80319c"
                    ],
                    "minLength": 32,
                    "maxLength": 32,
                    "pattern": "^[a-f0-9]{32}(?![\\s\\S])",
                    "description": "Unique trace identifier (32 lowercase hex characters)"
                },
                "ToolReadInput": {
                    "type": "object",
                    "properties": {
                        "service": {
