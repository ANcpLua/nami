                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 10,
                    "description": "How many of the slowest traces to return, 1 to 100; default 10. freshness.matched still counts every matching trace, and truncated is true when the limit left some out."
                }
            },
            "allOf": [
                {
                    "$ref": "#/$defs/ToolReadInput"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Rank the traces that started in the window (since, default the last hour) by duration, longest first, and return up to limit of them (default 10, at most 100) with trace ID, root operation, duration in milliseconds, start time and status (error if any span failed). Use it for latency questions; for failures start with errors_recent. operation keeps only traces whose root span has exactly this name (case-sensitive; take names from an earlier traces_slowest or traces_get answer). Pass a trace_id from the answer to traces_get for the spans.",
            "$defs": {
                "ToolReadInput": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "description": "Only telemetry from the service with exactly this service.name (case-sensitive). sources_status lists the names; an unknown name is refused with the known ones."
                        },
                        "since": {
                            "$ref": "#/$defs/TimeSpec",
                            "default": "-60m",
                            "description": "Start of the window: a negative duration relative to now (-30s, -15m, -2h, -7d) or a past RFC 3339 time (2026-11-22T13:00:00Z). The window ends now (when the snapshot was taken). Default -60m. traces_get reads a trace whole whatever since says."
                        },
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "maxItems": 128,
                            "description": "Return only these members of each result row (of the trace for traces_get). Default: all members. Unknown fields are refused with the allowed field names."
                        },
                        "maxBytes": {
                            "type": "integer",
                            "minimum": 1024,
                            "maximum": 262144,
                            "default": 32768,
                            "description": "Size budget for one page, in UTF-8 bytes of JSON, 1024 to 262144, default 32768. Rows that do not fit move to the next page (see next_cursor). Raise it only when a single row or span does not fit."
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId",
                            "description": "ID of the frozen view of the data an earlier answer returned. Pass it to get byte-identical answers across tools in one investigation. Expires 30 minutes after it was taken; then call without it. With cursor, snapshot_id is optional: the cursor carries its snapshot."
                        },
                        "cursor": {
                            "$ref": "#/$defs/Cursor",
                            "description": "Opaque next_cursor from the preceding page; keep all other arguments unchanged."
                        }
                    },
                    "description": "Arguments shared by every read-only tool."
                },
                "TimeSpec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Absolute RFC 3339 instant or a negative relative duration such as -15m, -2h, -7d or -30s."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
