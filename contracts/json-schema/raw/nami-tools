{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "nami-tools",
    "$defs": {
        "SourcesStatusInput": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SourcesStatusInput.json",
            "type": "object",
            "properties": {},
            "allOf": [
                {
                    "$ref": "#/$defs/ToolReadInput"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "List every service that has sent telemetry to nami, and for each of its three signals (traces, metrics, logs) whether it is active or silent. A signal is active when something arrived at or after since (default: the last hour) and silent otherwise; a silent signal carries silent_for and, if it was ever seen, last_seen. Call this first: it tells you which services exist (the values service accepts in every nami tool) and whether missing evidence means nothing happened or nothing was sent. nami stores metrics but has no tool that reads metric values. Rows are ordered by service name.",
            "$defs": {
                "ToolReadInput": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "description": "Only telemetry from the service with exactly this service.name (case-sensitive). sources_status lists the names; an unknown name is refused with the known ones."
                        },
                        "since": {
                            "$ref": "#/$defs/TimeSpec",
                            "default": "-60m",
                            "description": "Start of the window: a negative duration relative to now (-30s, -15m, -2h, -7d) or a past RFC 3339 time (2026-11-22T13:00:00Z). The window ends now (when the snapshot was taken). Default -60m. traces_get reads a trace whole whatever since says."
                        },
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "maxItems": 128,
                            "description": "Return only these members of each result row (of the trace for traces_get). Default: all members. Unknown fields are refused with the allowed field names."
                        },
                        "maxBytes": {
                            "type": "integer",
                            "minimum": 1024,
                            "maximum": 262144,
                            "default": 32768,
                            "description": "Size budget for one page, in UTF-8 bytes of JSON, 1024 to 262144, default 32768. Rows that do not fit move to the next page (see next_cursor). Raise it only when a single row or span does not fit."
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId",
                            "description": "ID of the frozen view of the data an earlier answer returned. Pass it to get byte-identical answers across tools in one investigation. Expires 30 minutes after it was taken; then call without it. With cursor, snapshot_id is optional: the cursor carries its snapshot."
                        },
                        "cursor": {
                            "$ref": "#/$defs/Cursor",
                            "description": "Opaque next_cursor from the preceding page; keep all other arguments unchanged."
                        }
                    },
                    "description": "Arguments shared by every read-only tool."
                },
                "TimeSpec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Absolute RFC 3339 instant or a negative relative duration such as -15m, -2h, -7d or -30s."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                }
            }
        },
        "SourcesStatusResult": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SourcesStatusResult.json",
            "type": "object",
            "properties": {
                "services": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ProjectedSourceStatus"
                    }
                }
            },
            "required": [
                "services"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolResult"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Recorded service and signal activity.",
            "$defs": {
                "ProjectedSourceStatus": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "string"
                        },
                        "signals": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/SignalStatus"
                            }
                        }
                    },
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "A field projection of SourceStatus; omitted members were not requested."
                },
                "ToolResult": {
                    "type": "object",
                    "properties": {
                        "freshness": {
                            "$ref": "#/$defs/Freshness"
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/Cursor"
                        }
                    },
                    "required": [
                        "freshness",
                        "snapshotId"
                    ],
                    "description": "Evidence metadata returned with every successful tool result."
                },
                "SignalStatus": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ActiveSignalStatus"
                        },
                        {
                            "$ref": "#/$defs/SilentSignalStatus"
                        }
                    ],
                    "description": "The latest receipt time for one signal, or how long it has been silent."
                },
                "Freshness": {
                    "type": "object",
                    "properties": {
                        "watermark": {
                            "$ref": "#/$defs/Timestamp",
                            "description": "Ingest is complete through this instant for every signal read."
                        },
                        "complete": {
                            "type": "boolean",
                            "description": "True only when the requested window ends at or before the watermark."
                        },
                        "examined": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Records examined, or null when unknown."
                        },
                        "matched": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Matching records, or null when the read was cut short."
                        },
                        "returned": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Items returned, or null when unknown."
                        },
                        "truncated": {
                            "type": "boolean",
                            "description": "True when a row limit, page limit or byte budget omitted matching items."
                        }
                    },
                    "required": [
                        "watermark",
                        "complete",
                        "examined",
                        "matched",
                        "returned",
                        "truncated"
                    ],
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "Evidence completeness for the requested window. Unknown counts remain null."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                },
                "ActiveSignalStatus": {
                    "type": "object",
                    "properties": {
                        "signal": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": "traces"
                                },
                                {
                                    "type": "string",
                                    "const": "metrics"
                                },
                                {
                                    "type": "string",
                                    "const": "logs"
                                }
                            ]
                        },
                        "kind": {
                            "type": "string",
                            "const": "active"
                        },
                        "lastSeen": {
                            "$ref": "#/$defs/Timestamp"
                        }
                    },
                    "required": [
                        "signal",
                        "kind",
                        "lastSeen"
                    ],
                    "unevaluatedProperties": {
                        "not": {}
                    }
                },
                "SilentSignalStatus": {
                    "type": "object",
                    "properties": {
                        "signal": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": "traces"
                                },
                                {
                                    "type": "string",
                                    "const": "metrics"
                                },
                                {
                                    "type": "string",
                                    "const": "logs"
                                }
                            ]
                        },
                        "kind": {
                            "type": "string",
                            "const": "silent"
                        },
                        "lastSeen": {
                            "$ref": "#/$defs/Timestamp"
                        },
                        "silentFor": {
                            "$ref": "#/$defs/IsoDuration"
                        }
                    },
                    "required": [
                        "signal",
                        "kind",
                        "silentFor"
                    ],
                    "unevaluatedProperties": {
                        "not": {}
                    }
                },
                "Timestamp": {
                    "type": "string",
                    "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
                    "description": "RFC 3339 timestamp preserved exactly as text, including fractional precision and offset. Leap seconds are not supported. Execution windows additionally require an instant representable by the telemetry store."
                },
                "Count": {
                    "type": "string",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Generic non-negative counter"
                },
                "IsoDuration": {
                    "type": "string",
                    "pattern": "^P(?!$)(([0-9]+Y)?([0-9]+M)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?|([0-9]+W)?)(?![\\s\\S])",
                    "description": "ISO 8601 duration format (e.g., PT1H30M)"
                }
            }
        },
        "ErrorsRecentInput": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ErrorsRecentInput.json",
            "type": "object",
            "properties": {},
            "allOf": [
                {
                    "$ref": "#/$defs/ToolReadInput"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Group the errors recorded in the window (since, default the last hour) by error type and operation, most frequent first, with first and last occurrence, a count and one example trace ID. Three things count as an error: a log record named exception, an exception event on a span, and a span with status error that recorded no exception. A plain log line at ERROR severity is not an error here; find those with logs_search. No stack traces are returned: pass example_trace_id to traces_get to read the exception event and the spans around it. operation is the span name, or log when the log record has no span.",
            "$defs": {
                "ToolReadInput": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "description": "Only telemetry from the service with exactly this service.name (case-sensitive). sources_status lists the names; an unknown name is refused with the known ones."
                        },
                        "since": {
                            "$ref": "#/$defs/TimeSpec",
                            "default": "-60m",
                            "description": "Start of the window: a negative duration relative to now (-30s, -15m, -2h, -7d) or a past RFC 3339 time (2026-11-22T13:00:00Z). The window ends now (when the snapshot was taken). Default -60m. traces_get reads a trace whole whatever since says."
                        },
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "maxItems": 128,
                            "description": "Return only these members of each result row (of the trace for traces_get). Default: all members. Unknown fields are refused with the allowed field names."
                        },
                        "maxBytes": {
                            "type": "integer",
                            "minimum": 1024,
                            "maximum": 262144,
                            "default": 32768,
                            "description": "Size budget for one page, in UTF-8 bytes of JSON, 1024 to 262144, default 32768. Rows that do not fit move to the next page (see next_cursor). Raise it only when a single row or span does not fit."
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId",
                            "description": "ID of the frozen view of the data an earlier answer returned. Pass it to get byte-identical answers across tools in one investigation. Expires 30 minutes after it was taken; then call without it. With cursor, snapshot_id is optional: the cursor carries its snapshot."
                        },
                        "cursor": {
                            "$ref": "#/$defs/Cursor",
                            "description": "Opaque next_cursor from the preceding page; keep all other arguments unchanged."
                        }
                    },
                    "description": "Arguments shared by every read-only tool."
                },
                "TimeSpec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Absolute RFC 3339 instant or a negative relative duration such as -15m, -2h, -7d or -30s."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                }
            }
        },
        "ErrorsRecentResult": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ErrorsRecentResult.json",
            "type": "object",
            "properties": {
                "groups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ProjectedErrorGroup"
                    }
                }
            },
            "required": [
                "groups"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolResult"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Groups of errors from log events, span events and error-status spans.",
            "$defs": {
                "ProjectedErrorGroup": {
                    "type": "object",
                    "properties": {
                        "errorType": {
                            "type": "string"
                        },
                        "operation": {
                            "type": "string"
                        },
                        "firstSeen": {
                            "$ref": "#/$defs/Timestamp"
                        },
                        "lastSeen": {
                            "$ref": "#/$defs/Timestamp"
                        },
                        "count": {
                            "$ref": "#/$defs/Count"
                        },
                        "exampleTraceId": {
                            "$ref": "#/$defs/TraceId"
                        },
                        "source": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": "log_event"
                                },
                                {
                                    "type": "string",
                                    "const": "span_event"
                                },
                                {
                                    "type": "string",
                                    "const": "span_status"
                                }
                            ],
                            "description": "Where the errors were recorded, the first that applies to any of them: log_event, a log record named exception; span_event, an exception event on a span; span_status, a span with status error and no exception recorded for it."
                        }
                    },
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "A field projection of ErrorGroup; omitted members were not requested."
                },
                "ToolResult": {
                    "type": "object",
                    "properties": {
                        "freshness": {
                            "$ref": "#/$defs/Freshness"
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/Cursor"
                        }
                    },
                    "required": [
                        "freshness",
                        "snapshotId"
                    ],
                    "description": "Evidence metadata returned with every successful tool result."
                },
                "Timestamp": {
                    "type": "string",
                    "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
                    "description": "RFC 3339 timestamp preserved exactly as text, including fractional precision and offset. Leap seconds are not supported. Execution windows additionally require an instant representable by the telemetry store."
                },
                "Count": {
                    "type": "string",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Generic non-negative counter"
                },
                "TraceId": {
                    "type": "string",
                    "examples": [
                        "0af7651916cd43dd8448eb211c80319c"
                    ],
                    "minLength": 32,
                    "maxLength": 32,
                    "pattern": "^[a-f0-9]{32}(?![\\s\\S])",
                    "description": "Unique trace identifier (32 lowercase hex characters)"
                },
                "Freshness": {
                    "type": "object",
                    "properties": {
                        "watermark": {
                            "$ref": "#/$defs/Timestamp",
                            "description": "Ingest is complete through this instant for every signal read."
                        },
                        "complete": {
                            "type": "boolean",
                            "description": "True only when the requested window ends at or before the watermark."
                        },
                        "examined": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Records examined, or null when unknown."
                        },
                        "matched": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Matching records, or null when the read was cut short."
                        },
                        "returned": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Count"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Items returned, or null when unknown."
                        },
                        "truncated": {
                            "type": "boolean",
                            "description": "True when a row limit, page limit or byte budget omitted matching items."
                        }
                    },
                    "required": [
                        "watermark",
                        "complete",
                        "examined",
                        "matched",
                        "returned",
                        "truncated"
                    ],
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "Evidence completeness for the requested window. Unknown counts remain null."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                }
            }
        },
        "TracesGetInput": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "TracesGetInput.json",
            "type": "object",
            "properties": {
                "traceId": {
                    "$ref": "#/$defs/TraceId"
                }
            },
            "required": [
                "traceId"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolReadInput"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Read one trace by its 32-character lowercase hex trace ID: its root span, duration, services, error flag and every span with attributes, events (including exception events) and links. Use it after errors_recent, traces_slowest or logs_search gave you a trace ID. The trace is read whole whatever since says, up to the snapshot; with service, it is found only when one of its spans is from that service. Spans are ordered by start time and paged: when next_cursor is present, call again with it to read the next spans. To keep the answer small, pass fields, for example [\"trace_id\",\"root_span\",\"span_count\",\"duration_ns\",\"has_error\"] without spans.",
            "$defs": {
                "TraceId": {
                    "type": "string",
                    "examples": [
                        "0af7651916cd43dd8448eb211c80319c"
                    ],
                    "minLength": 32,
                    "maxLength": 32,
                    "pattern": "^[a-f0-9]{32}(?![\\s\\S])",
                    "description": "Unique trace identifier (32 lowercase hex characters)"
                },
                "ToolReadInput": {
                    "type": "object",
                    "properties": {
                        "service": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "description": "Only telemetry from the service with exactly this service.name (case-sensitive). sources_status lists the names; an unknown name is refused with the known ones."
                        },
                        "since": {
                            "$ref": "#/$defs/TimeSpec",
                            "default": "-60m",
                            "description": "Start of the window: a negative duration relative to now (-30s, -15m, -2h, -7d) or a past RFC 3339 time (2026-11-22T13:00:00Z). The window ends now (when the snapshot was taken). Default -60m. traces_get reads a trace whole whatever since says."
                        },
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "maxItems": 128,
                            "description": "Return only these members of each result row (of the trace for traces_get). Default: all members. Unknown fields are refused with the allowed field names."
                        },
                        "maxBytes": {
                            "type": "integer",
                            "minimum": 1024,
                            "maximum": 262144,
                            "default": 32768,
                            "description": "Size budget for one page, in UTF-8 bytes of JSON, 1024 to 262144, default 32768. Rows that do not fit move to the next page (see next_cursor). Raise it only when a single row or span does not fit."
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId",
                            "description": "ID of the frozen view of the data an earlier answer returned. Pass it to get byte-identical answers across tools in one investigation. Expires 30 minutes after it was taken; then call without it. With cursor, snapshot_id is optional: the cursor carries its snapshot."
                        },
                        "cursor": {
                            "$ref": "#/$defs/Cursor",
                            "description": "Opaque next_cursor from the preceding page; keep all other arguments unchanged."
                        }
                    },
                    "description": "Arguments shared by every read-only tool."
                },
                "TimeSpec": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Absolute RFC 3339 instant or a negative relative duration such as -15m, -2h, -7d or -30s."
                },
                "SnapshotId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
                },
                "Cursor": {
                    "type": "string",
                    "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
                }
            }
        },
        "TracesGetResult": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "TracesGetResult.json",
            "type": "object",
            "properties": {
                "trace": {
                    "$ref": "#/$defs/ProjectedTrace"
                }
            },
            "required": [
                "trace"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolResult"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The requested trace and evidence completeness.",
            "$defs": {
                "ProjectedTrace": {
                    "type": "object",
                    "properties": {
                        "spans": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/Span"
                            },
                            "description": "All spans in this trace"
                        },
                        "traceId": {
                            "$ref": "#/$defs/TraceId",
                            "description": "Trace identifier"
                        },
                        "rootSpan": {
                            "$ref": "#/$defs/Span",
                            "description": "Root span of the trace"
                        },
                        "spanCount": {
                            "type": "integer",
                            "minimum": -2147483648,
                            "maximum": 2147483647,
