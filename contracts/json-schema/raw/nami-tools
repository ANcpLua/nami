        "ErrorsRecentResult": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ErrorsRecentResult.json",
            "type": "object",
            "properties": {
                "groups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ProjectedErrorGroup"
                    }
                }
            },
            "required": [
                "groups"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolResult"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Groups of errors from log events, span events and error-status spans.",
            "$defs": {
                "ProjectedErrorGroup": {
                    "type": "object",
                    "properties": {
                        "errorType": {
                            "type": "string"
                        },
                        "operation": {
                            "type": "string"
                        },
                        "firstSeen": {
                            "$ref": "#/$defs/Timestamp"
                        },
                        "lastSeen": {
                            "$ref": "#/$defs/Timestamp"
                        },
                        "count": {
                            "$ref": "#/$defs/Count"
                        },
                        "exampleTraceId": {
                            "$ref": "#/$defs/TraceId"
                        },
                        "source": {
                            "anyOf": [
                                {
                                    "type": "string",
                                    "const": "log_event"
                                },
                                {
                                    "type": "string",
                                    "const": "span_event"
                                },
                                {
                                    "type": "string",
                                    "const": "span_status"
                                }
                            ]
                        }
                    },
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "A field projection of ErrorGroup; omitted members were not requested."
                },
                "ToolResult": {
                    "type": "object",
                    "properties": {
                        "freshness": {
                            "$ref": "#/$defs/Freshness"
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/Cursor"
                        }
                    },
                    "required": [
                        "freshness",
                        "snapshotId"
                    ],
                    "description": "Evidence metadata returned with every successful tool result."
                },
                "Timestamp": {
                    "type": "string",
                    "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
                    "description": "RFC 3339 timestamp preserved exactly as text, including fractional precision and offset. Leap seconds are not supported. Execution windows additionally require an instant representable by the telemetry store."
                },
                "Count": {
                    "type": "string",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Generic non-negative counter"
                },
                "TraceId": {
                    "type": "string",
                    "examples": [
                        "0af7651916cd43dd8448eb211c80319c"
                    ],
                    "minLength": 32,
                    "maxLength": 32,
                    "pattern": "^[a-f0-9]{32}(?![\\s\\S])",
                    "description": "Unique trace identifier (32 lowercase hex characters)"
                },
                "Freshness": {
                    "type": "object",
                    "properties": {
                        "watermark": {
                            "$ref": "#/$defs/Timestamp",
                            "description": "Ingest is complete through this instant for every signal read."
                        },
                        "complete": {
                            "type": "boolean",
                            "description": "True only when the requested window ends at or before the watermark."
                        },
                        "examined": {
