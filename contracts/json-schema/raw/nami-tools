                }
            }
        },
        "TracesGetResult": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "TracesGetResult.json",
            "type": "object",
            "properties": {
                "trace": {
                    "$ref": "#/$defs/ProjectedTrace"
                }
            },
            "required": [
                "trace"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/ToolResult"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The requested trace and evidence completeness.",
            "$defs": {
                "ProjectedTrace": {
                    "type": "object",
                    "properties": {
                        "spans": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/Span"
                            },
                            "description": "All spans in this trace"
                        },
                        "traceId": {
                            "$ref": "#/$defs/TraceId",
                            "description": "Trace identifier"
                        },
                        "rootSpan": {
                            "$ref": "#/$defs/Span",
                            "description": "Root span of the trace"
                        },
                        "spanCount": {
                            "type": "integer",
                            "minimum": -2147483648,
                            "maximum": 2147483647,
                            "description": "Total span count"
                        },
                        "durationNs": {
                            "$ref": "#/$defs/DurationNs",
                            "description": "Trace duration in nanoseconds"
                        },
                        "startTime": {
                            "$ref": "#/$defs/Timestamp",
                            "description": "Trace start time"
                        },
                        "endTime": {
                            "$ref": "#/$defs/Timestamp",
                            "description": "Trace end time"
                        },
                        "services": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Services involved in this trace"
                        },
                        "hasError": {
                            "type": "boolean",
                            "description": "Whether trace contains errors"
                        }
                    },
                    "unevaluatedProperties": {
                        "not": {}
                    },
                    "description": "A projected trace. An omitted field was not requested; it is not a fabricated value."
                },
                "ToolResult": {
                    "type": "object",
                    "properties": {
                        "freshness": {
                            "$ref": "#/$defs/Freshness"
                        },
                        "snapshotId": {
                            "$ref": "#/$defs/SnapshotId"
                        },
                        "nextCursor": {
                            "$ref": "#/$defs/Cursor"
                        }
                    },
                    "required": [
                        "freshness",
                        "snapshotId"
                    ],
                    "description": "Evidence metadata returned with every successful tool result."
                },
                "Span": {
                    "type": "object",
                    "properties": {
                        "spanId": {
                            "$ref": "#/$defs/SpanId",
                            "description": "Unique span identifier (16 hex chars)"
                        },
                        "traceId": {
                            "$ref": "#/$defs/TraceId",
                            "description": "Trace identifier (32 hex chars)"
                        },
                        "parentSpanId": {
                            "$ref": "#/$defs/SpanId",
                            "description": "Parent span identifier (null for root spans)"
                        },
                        "traceState": {
                            "$ref": "#/$defs/TraceState",
                            "description": "W3C trace state"
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Human-readable span name"
                        },
                        "kind": {
                            "$ref": "#/$defs/SpanKind",
                            "description": "Span kind"
                        },
                        "startTimeUnixNano": {
                            "$ref": "#/$defs/UnixNanos",
                            "description": "Start timestamp in nanoseconds since epoch"
                        },
                        "endTimeUnixNano": {
                            "$ref": "#/$defs/UnixNanos",
                            "description": "End timestamp in nanoseconds since epoch"
                        },
                        "attributes": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/Attribute"
                            },
                            "description": "Span attributes"
                        },
                        "droppedAttributesCount": {
                            "$ref": "#/$defs/Count",
                            "description": "Dropped attributes count"
                        },
                        "events": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/SpanEvent"
                            },
                            "description": "Span events (logs attached to span)"
                        },
                        "droppedEventsCount": {
                            "$ref": "#/$defs/Count",
                            "description": "Dropped events count"
                        },
                        "links": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/SpanLink"
                            },
                            "description": "Links to other spans"
                        },
                        "droppedLinksCount": {
                            "$ref": "#/$defs/Count",
                            "description": "Dropped links count"
                        },
                        "status": {
                            "$ref": "#/$defs/SpanStatus",
                            "description": "Span status"
                        },
                        "flags": {
                            "$ref": "#/$defs/OtlpFlags",
                            "description": "Span flags"
                        },
                        "resource": {
                            "$ref": "#/$defs/Resource",
                            "description": "Resource describing the entity that produced this span"
                        },
                        "instrumentationScope": {
                            "$ref": "#/$defs/InstrumentationScope",
                            "description": "Instrumentation scope"
                        }
                    },
