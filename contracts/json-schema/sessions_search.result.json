{
  "type": "object",
  "description": "Sessions with an event in the window, most recent last_seen first.",
  "properties": {
    "freshness": {
      "type": "object",
      "required": [
        "watermark",
        "complete",
        "examined",
        "matched",
        "returned",
        "truncated"
      ],
      "properties": {
        "watermark": {
          "type": "string",
          "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
          "description": "Ingest is complete through this instant for every signal read."
        },
        "complete": {
          "type": "boolean",
          "description": "True only when the requested window ends at or before the watermark."
        },
        "examined": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Generic non-negative counter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Records examined, or null when unknown."
        },
        "matched": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Generic non-negative counter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Matching records, or null when the read was cut short."
        },
        "returned": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Generic non-negative counter"
            },
            {
              "type": "null"
            }
          ],
          "description": "Items returned, or null when unknown."
        },
        "truncated": {
          "type": "boolean",
          "description": "True when a row limit, page limit or byte budget omitted matching items."
        }
      },
      "description": "Evidence completeness for the requested window. Unknown counts remain null.",
      "additionalProperties": false
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Opaque, project-scoped identity of an immutable telemetry snapshot."
    },
    "next_cursor": {
      "type": "string",
      "description": "Opaque pagination cursor. Pass the `next_cursor` of one page to receive the\nnext page of the same query. Its content is not part of the contract and\nmust not be parsed or built by a client."
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.+$)[A-Za-z0-9._~-]{1,128}(?![\\s\\S])",
            "description": "Unique session identifier: URL-safe characters, at least one, at most 128, not only dots. The same rule the SDK enforces on the baggage header."
          },
          "agent_name": {
            "type": "string",
            "description": "The gen_ai.agent.name resource attribute, when the session sets one."
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Models of the session's api_request events, sorted."
          },
          "efforts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Effort levels of the session's api_request events, sorted."
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Token count (for LLM operations)"
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Token count (for LLM operations)"
          },
          "cache_read_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Token count (for LLM operations)"
          },
          "cache_creation_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Token count (for LLM operations)"
          },
          "cost_usd_micros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Sum of cost_usd_micros over the session's api_request events."
          },
          "tool_call_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "tool_result events."
          },
          "failed_tool_call_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "tool_result events whose success is false."
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0,
            "description": "From first_seen to last_seen."
          },
          "first_seen": {
            "type": "string",
            "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
            "description": "RFC 3339 timestamp preserved exactly as text, including fractional precision and offset. Leap seconds are not supported. Execution windows additionally require an instant representable by the telemetry store."
          },
          "last_seen": {
            "type": "string",
            "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
            "description": "RFC 3339 timestamp preserved exactly as text, including fractional precision and offset. Leap seconds are not supported. Execution windows additionally require an instant representable by the telemetry store."
          }
        },
        "description": "A field projection of SessionSummary; omitted members were not requested.",
        "additionalProperties": false
      }
    }
  },
  "required": [
    "freshness",
    "snapshot_id",
    "sessions"
  ],
  "additionalProperties": false
}
