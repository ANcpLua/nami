<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>Nami.Build</RootNamespace><IsPackable>false</IsPackable>
    <FalloutRootDirectory>..</FalloutRootDirectory><FalloutScriptDirectory>..</FalloutScriptDirectory>
    <FalloutExcludeConfig>true</FalloutExcludeConfig>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Fallout.Common"/><PackageReference Include="Fallout.Components"/></ItemGroup>
  <ItemGroup>
    <!-- MSBuildLocator loads the SDK's Frameworks assembly together with MSBuild. -->
    <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
