<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(NamiOrchestrationPackageVersion)' == ''">
    <ProjectReference Include="../../../packages/Nami.Orchestration/Nami.Orchestration.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NamiOrchestrationPackageVersion)' != ''">
    <PackageReference Include="Nami.Orchestration" VersionOverride="$(NamiOrchestrationPackageVersion)" />
  </ItemGroup>
</Project>
