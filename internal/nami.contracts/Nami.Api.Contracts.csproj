<Project Sdk="Microsoft.NET.Sdk">

  <!-- Internal wire contracts for the single Nami binary. Nami/ is generated by
       ./eng/build.sh Contracts and committed; VerifyContracts checks regeneration parity.
       Runtime validation and AOT serializer helpers live beside the generated sources. -->
  <PropertyGroup>
    <RootNamespace>Nami.Api.Contracts</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Nami/Api/Contracts/contract-schemas.json" LogicalName="nami.contract-schemas.json"/>
  </ItemGroup>

</Project>
