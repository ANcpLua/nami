<Project Sdk="ANcpLua.NET.Sdk">
  <!-- DuckDB compile assets stay private to the product storage assembly. Integration tests
       explicitly reference the same pinned driver to verify physical schema and failure boundaries. -->
  <PropertyGroup>
    <RootNamespace>Nami.Collector.Storage</RootNamespace>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../internal/nami.semconv/Nami.SemanticConventions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" PrivateAssets="compile"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../nami.collector.ingestion/nami.collector.ingestion.csproj"/>
    <ProjectReference Include="../../internal/nami.collector.storage.generators/nami.collector.storage.generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="nami"/>
    <InternalsVisibleTo Include="Nami.Tests"/>
    <InternalsVisibleTo Include="Nami.IntegrationTests"/>
    <InternalsVisibleTo Include="Nami.EndToEndTests"/>
  </ItemGroup>

</Project>
