{
  "$schema": "https://raw.githubusercontent.com/microsoft/testfx/v4.5.1/docs/testconfig.schema.json",
  "commandLineOptions": {
    "show-test-results": "all",
    "show-stdout": "All",
    "show-stderr": "All",
    "progress": "auto",
    "ansi": "off"
  },
  "mstest": {
    "timeout": { "test": 300000, "useCooperativeCancellation": true },
    "output": { "captureTrace": "Live" },
    "execution": { "captureAssertionFailureDiagnostics": true, "treatDiscoveryWarningsAsErrors": true }
  }
}
