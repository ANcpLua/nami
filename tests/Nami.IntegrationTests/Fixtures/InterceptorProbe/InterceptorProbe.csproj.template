<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built as a product generator is: netstandard2.0 against the pinned Microsoft.CodeAnalysis.CSharp
       package, not against the SDK's compiler assemblies as CompilerProbes is. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <Compile Include="$(FixtureSourceDirectory)InterceptorProbeGenerator.cs" />
  </ItemGroup>
</Project>
