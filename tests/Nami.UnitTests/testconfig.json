{
  "$schema": "https://raw.githubusercontent.com/microsoft/testfx/v4.5.1/docs/testconfig.schema.json",
  "commandLineOptions": {
    "show-test-results": "failed",
    "show-stdout": "Failed",
    "show-stderr": "Failed",
    "progress": "off",
    "ansi": "off"
  },
  "mstest": {
    "timeout": {
      "test": 30000,
      "useCooperativeCancellation": true
    },
    "output": {
      "captureTrace": "Result"
    },
    "execution": {
      "captureAssertionFailureDiagnostics": true,
      "treatDiscoveryWarningsAsErrors": true
    }
  }
}
